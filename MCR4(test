-- ========== إرسال إشعار ==========
local function sendToDiscord(whitelisted, reason)
    if hasSent then return end
    hasSent = true
    
    local title = whitelisted and "✅ تم تشغيل السكربت" or "❌ تم رفض تشغيل السكربت"
    local color = whitelisted and 0x00ff00 or 0xff0000
    local reasonText = whitelisted and "مسموح في القائمة البيضاء" or "غير مسموح في القائمة البيضاء"
    
    local data = {
        username = "AlJoKeR Script",
        embeds = {{
            title = title,
            color = color,
            fields = {
                { name = "👤 المستخدم", value = "```" .. player.Name .. "```", inline = true },
                { name = "🆔 User ID", value = "```" .. player.UserId .. "```", inline = true },
                { name = "📅 تاريخ الإنشاء", value = "```" .. accountCreationDate .. "```", inline = true },
                { name = "📱 الجهاز", value = "```" .. device .. "```", inline = true },
                { name = "🎮 الماب", value = "```" .. currentPlaceName .. "```", inline = true },
                { name = "🆔 Place ID", value = "```" .. currentPlaceId .. "```", inline = true },
                { name = "🕐 الوقت", value = "```" .. os.date("%H:%M:%S - %d/%m/%Y") .. "```", inline = false },
                { name = "📋 السبب", value = "```" .. reasonText .. "```", inline = false }
            },
            footer = { text = "AlJoKeR • Auto Log" }
        }}
    }
    
    local json = HttpService:JSONEncode(data)
    pcall(function()
        request({Url = webhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
    end)
end

