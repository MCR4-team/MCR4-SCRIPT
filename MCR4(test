-- ========== دوال السكربتات ==========
local scriptButtons = {}
local filteredScripts = {}

local function createScriptButton(scriptData)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -6, 0, 48)
    holder.BackgroundTransparency = 1
    holder.Parent = scrollContainer
    
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 1, -2)
    card.BackgroundColor3 = Colors.deepBlack
    card.BackgroundTransparency = 0
    card.BorderSizePixel = 0
    card.Parent = holder
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
    
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(0, 34, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = scriptData.icon
    iconLabel.TextColor3 = scriptData.color
    iconLabel.TextSize = 18
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Parent = card
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.6, -40, 0, 18)
    nameLabel.Position = UDim2.new(0, 40, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = scriptData.name
    nameLabel.TextColor3 = Colors.textWhite
    nameLabel.TextSize = 9
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = card
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(0.6, -40, 0, 14)
    descLabel.Position = UDim2.new(0, 40, 0, 24)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = scriptData.desc
    descLabel.TextColor3 = Colors.textDim
    descLabel.TextSize = 6
    descLabel.Font = Enum.Font.Gotham
    descLabel.Parent = card
    
    local runBtn = Instance.new("TextButton")
    runBtn.Size = UDim2.new(0, 55, 0, 26)
    runBtn.Position = UDim2.new(1, -62, 0.5, -13)
    runBtn.BackgroundColor3 = Colors.darkerBlack
    runBtn.Text = "▶ تشغيل"
    runBtn.TextColor3 = Colors.neonRed
    runBtn.TextSize = 8
    runBtn.Font = Enum.Font.GothamBold
    runBtn.Parent = card
    Instance.new("UICorner", runBtn).CornerRadius = UDim.new(0, 5)
    
    local isRunning = false
    
    local function executeScript()
        if isRunning then return end
        isRunning = true
        runBtn.Text = "⌛ جاري..."
        runBtn.BackgroundColor3 = Color3.fromRGB(30, 15, 15)
        
        task.spawn(function()
            local success = false
            if scriptData.name == "AlJoKeR-Anti-fling" then
                pcall(loadAntiFling)
                success = true
            else
                pcall(function()
                    local scriptContent = game:HttpGet(scriptData.url)
                    local func = loadstring(scriptContent)
                    if func then
                        func()
                        success = true
                    end
                end)
            end
            
            if success then
                runBtn.Text = "✓ تم"
                runBtn.BackgroundColor3 = Color3.fromRGB(20, 30, 20)
                task.wait(1)
                runBtn.Text = "▶ تشغيل"
                runBtn.BackgroundColor3 = Colors.darkerBlack
            else
                runBtn.Text = "✗ فشل"
                runBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
                task.wait(1)
                runBtn.Text = "▶ تشغيل"
                runBtn.BackgroundColor3 = Colors.darkerBlack
            end
            isRunning = false
        end)
    end
    
    runBtn.MouseButton1Click:Connect(executeScript)
    if runBtn.TouchTap then runBtn.TouchTap:Connect(executeScript) end
    
    return holder
end

local function updateScriptList(searchText)
    for _, btn in pairs(scriptButtons) do
        pcall(function() btn:Destroy() end)
    end
    scriptButtons = {}
    filteredScripts = {}
    
    local searchLower = string.lower(searchText)
    
    for _, script in pairs(scripts) do
        local match = searchText == "" or 
                     string.find(string.lower(script.name), searchLower) or 
                     string.find(string.lower(script.desc), searchLower)
        if match then
            table.insert(filteredScripts, script)
            local btn = createScriptButton(script)
            table.insert(scriptButtons, btn)
        end
    end
    
    statsLabel.Text = "✨ " .. #filteredScripts .. " سكربت | AlJoKeR ✨"
    scrollContainer.CanvasSize = UDim2.new(0, 0, 0, #filteredScripts * 52 + 10)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    updateScriptList(searchBox.Text)
end)

