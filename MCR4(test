-- حركة السحب
UIS.InputChanged:Connect(function(input)
    if containerDragData.active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - containerDragData.start
        ToggleContainer.Position = UDim2.new(
            containerDragData.startPos.X.Scale,
            containerDragData.startPos.X.Offset + delta.X,
            containerDragData.startPos.Y.Scale,
            containerDragData.startPos.Y.Offset + delta.Y
        )
    end
end)

